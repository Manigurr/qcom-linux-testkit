prefix=/usr
datadir=${prefix}/share
includedir=${prefix}/include
libdir=${prefix}/lib/aarch64-linux-gnu

exec_prefix=${prefix}
toolsdir=${exec_prefix}/bin
pluginsdir=${libdir}/gstreamer-1.0
datarootdir=${prefix}/share
girdir=${datadir}/gir-1.0
typelibdir=${libdir}/girepository-1.0

Name: gstreamer-codecparsers-1.0
Description: Bitstream parsers for GStreamer elements
Version: 1.29.2.1
Requires: gstreamer-1.0, gstreamer-base-1.0
Requires.private: gstreamer-video-1.0, gstreamer-allocators-1.0, orc-0.4, glib-2.0 >=  2.64.0, gobject-2.0, gmodule-no-export-2.0
Libs: -L${libdir} -lgstcodecparsers-1.0
Libs.private: -lm -latomic -pthread
Cflags: -I${includedir}/gstreamer-1.0
